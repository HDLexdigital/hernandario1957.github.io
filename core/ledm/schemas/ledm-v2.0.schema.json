{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LEDM 2.0",
  "description": "Legal Editorial Domain Model 2.0",
  "type": "object",
  "required": ["meta", "provenance", "integrity", "structure"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["model", "jurisdiction", "corpusId", "documentId", "version"],
      "additionalProperties": false,
      "properties": {
        "model": { "const": "LEDM-2.0" },
        "jurisdiction": { "type": "string", "minLength": 2 },
        "corpusId": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "version": {
          "type": "object",
          "required": ["id", "number", "status"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "number": { "type": "integer", "minimum": 1 },
            "status": {
              "type": "string",
              "enum": ["CURRENT", "SUPERSEDED", "DRAFT"]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceType", "sourceId", "retrievedAt", "transformationsApplied"],
      "additionalProperties": false,
      "properties": {
        "sourceType": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string" },
        "transformationsApplied": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["sourceHash", "contentHash", "ledmHash"],
      "additionalProperties": false,
      "properties": {
        "sourceHash": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "SHA-256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "contentHash": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "SHA-256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "ledmHash": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "SHA-256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "required": ["type", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nodeId", "type", "children"],
            "additionalProperties": false,
            "properties": {
              "nodeId": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "children": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/contentNode" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "contentNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "children"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/contentNode" }
            }
          }
        }
      ]
    }
  }
}