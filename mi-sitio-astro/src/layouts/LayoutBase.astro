---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      body { background: #111827; color: #f9fafb; font-family: sans-serif; padding: 2rem; }
      main { max-width: 32rem; margin: 0 auto; background: #1f2937; padding: 1.5rem; border-radius: 0.5rem; }
      h1 { color: #818cf8; }
      .badge { background: #111827; padding: 1rem; border-radius: 0.25rem; font-family: monospace; color: #34d399; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
