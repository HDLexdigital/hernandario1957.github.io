# ============================================================
# LexDigitalHD 2.0 — .gitignore
# ============================================================

# ------------------------------------------------------------
# Node.js
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test artifacts
coverage/
.nyc_output/
.jest/

# Build / distribution artifacts
dist/
build/
out/

# ------------------------------------------------------------
# Runtime / temporary files
# ------------------------------------------------------------
tmp/
temp/
.temp/
.cache/
*.tmp
*.temp
*.bak
*.old
*.orig

# Runtime logs
logs/
*.log

# ------------------------------------------------------------
# Generated application output
# ------------------------------------------------------------
salida/
salidaXHTML/
output/
outputs/

# Generated request/response IPC files
*.request.json
*.response.json
request-*.json
response-*.json

# ------------------------------------------------------------
# InDesign / Adobe temporary files
# ------------------------------------------------------------
# Lock files created by Adobe applications
*.idlk

# InDesign recovery / temporary files
*.indb~
*.indd~
*.indt~
*.idml~

# Adobe autosave / recovery directories
DataRecovery/
Recovery/

# ------------------------------------------------------------
# Operating system
# ------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# ------------------------------------------------------------
# Environment / local configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Local tooling / machine-specific configuration
# ------------------------------------------------------------
*.local.json
*.local.yaml
*.local.yml

# ------------------------------------------------------------
# Scratch / manual inspection files
# ------------------------------------------------------------
scratch/
sandbox/
debug/
debug-output/
*.dump
*.trace

# ------------------------------------------------------------
# Generated reports
# ------------------------------------------------------------
reports/
*.report.txt
*.report.json
*.report.html

# ------------------------------------------------------------
# PowerShell temporary files
# ------------------------------------------------------------
*.ps1.tmp

# ------------------------------------------------------------
# Explicitly DO NOT ignore:
#
#   core/
#   test/
#   fixtures/
#   schemas/
#   resources/
#   docs/
#   *.json contractual fixtures
#   CIDM_real.json
#   CIDM_subset_articulos_1_10.json
#   package.json
#   package-lock.json
# ------------------------------------------------------------