{
    "manifestVersion": 5,
    "id": "com.lexmotor.uxp",
    "name": "Lexmotor Compiler",
    "version": "1.0.0",
    "main": "index.html",
    "host": [
        {
            "app": "ID",
            "minVersion": "21.0"
        }
    ],
    "entrypoints": [
        {
            "type": "panel",
            "id": "lexmotorPanel",
            "label": "Lexmotor Compiler",
            "minimumSize": {
                "width": 300,
                "height": 400
            }
        }
    ],
    "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
        "domains": [
            "http://127.0.0.1:3000",
            "http://localhost:3000"
        ]
    },
    "allowCodeEval": true
}
}