{
  "name": "lexdigital",
  "version": "1.0.0",
  "description": "Compilador editorial LexDigital",
  "main": "src/index.js",
  "scripts": {
    "build": "astro build",
    "test": "jest --config jest.config.js",
    "test:contracts": "jest core/ledm/test/ledm-v2.contract.test.js core/cidm/test/cidm-v1.contract.test.js --config jest.config.js --verbose",
    "test:ledm": "jest core/ledm/test/ledm-v2.contract.test.js --config jest.config.js --verbose",
    "test:cidm": "jest core/cidm/test/cidm-v1.contract.test.js --config jest.config.js --verbose",
    "test:compiler": "jest core/compiler/test/semantic-compiler.contract.test.js --config jest.config.js --verbose",
    "test:integration": "jest core/integration/test/cidm-to-ledm.pipeline.test.js --config jest.config.js --verbose",
    "test:core:all": "jest core/ --config jest.config.js --verbose",
    "test:all": "npm run build:public && npm run preflight",
    "test:esencial": "jest test/esencial/suite-esencial.test.js --verbose",
    "test:unit": "jest test/unit --silent",
    "test:integration:legacy": "jest test/integration --runInBand",
    "test:e2e": "jest test/integration/e2e.pipeline.test.js --detectOpenHandles",
    "test:coverage": "jest --coverage --coverageDirectory='coverage'",
    "test:watch": "jest --watch",
    "audit:core": "node scripts/verificar_core.js",
    "ci:local": "npm run audit:core && npm run test:core:all",
    "ci:a11y": "jest core/integration/test/a11y-audit.test.js --config jest.config.js --verbose",
    "ci:epub": "jest core/integration/test/e2e-full-constitution.test.js --config jest.config.js --verbose && node scripts/epubcheck.js publication_full.epub",
    "ci:all": "npm run ci:local && npm run ci:epub && npm run ci:web && npm run ci:pdf",
    "build:web": "node src/cli/lexmotorBatchCli.js --profile WEB --input ./entrada --output ./salida/web",
    "preview:web": "npx serve public",
    "ci:web": "npm run build:web && npx jest core/web/test --runInBand",
    "build:pdf": "node scripts/build-pdf-full.js",
    "validate:pdfua": "node scripts/validate-pdfua.js output/experiment-weasyprint-ua-full.pdf",
    "ci:pdf": "npm run build:pdf && npm run validate:pdfua",
    "start": "node src/index.js",
    "pipeline": "node LexDigital-Pipeline/server.js",
    "verify": "node scripts/verificar-estructura.js",
    "build:print": "node scripts/build-pdf-print.js",
    "convert:pdfx1a": "bash scripts/convert-pdfx1a.sh output/experiment-print-base.pdf output/experiment-print-pdfx1a.pdf",
    "ci:print": "npm run build:print && npm run convert:pdfx1a",
    "publish": "node scripts/publish.js",
    "ci:publish": "npm run publish:constitucion && jest core/publishing/test --runInBand",
    "publish:constitucion": "node scripts/publish-constitucion.js",
    "start:api": "node core/api/server.js",
    "procesar:ui": "electron scripts/ui/main.js",
    "build:public": "node scripts/build-public.js",
    "preflight": "node scripts/preflight.js",
    "build:epub": "node src/cli/lexmotorBatchCli.js --profile EPUB --input ./entrada --output ./salida/epub",
    "build:web:dry": "node src/cli/lexmotorBatchCli.js --profile WEB --input ./entrada --output ./salida/web --dry-run",
    "build:epub:dry": "node src/cli/lexmotorBatchCli.js --profile EPUB --input ./entrada --output ./salida/epub --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@xmldom/xmldom": "^0.9.11",
    "adm-zip": "^0.6.0",
    "archiver": "^5.3.2",
    "astro": "^7.3.5",
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "jsdom": "^24.1.3",
    "jszip": "^3.10.1",
    "pagedjs": "^0.4.3",
    "puppeteer": "^25.11.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^31.7.7",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
