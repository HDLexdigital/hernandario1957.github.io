---
interface Version {
  id: string;
  version: string;
  fecha: Date;
  modificacion: string;
  hash: string;
}
interface Props {
  versiones: Version[];
}
const { versiones } = Astro.props;
---

<section class="rounded-lg border border-border bg-surface-card p-5 mt-8 shadow-sm transition-all" aria-labelledby="history-heading">
    <h2 id="history-heading" class="font-serif text-xl font-semibold text-content mb-4">Historial de Trazabilidad y Versiones</h2>

    <!-- Región viva para anunciar resultados de verificación -->
    <div id="verify-announcer" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

    <div class="w-full overflow-x-auto focus:outline-none focus:ring-2 focus:ring-brand-600 rounded" tabindex="0" aria-label="Tabla de historial de versiones desplazable, use las flechas para navegar">
        <table class="w-full text-left text-sm text-content-muted border-collapse min-w-[800px]">
            <caption class="sr-only">Registro de cambios y validación criptográfica de las versiones del documento</caption>
            <thead class="bg-surface-muted text-content border-b border-border text-xs uppercase font-semibold">
                <tr>
                    <th scope="col" class="px-4 py-3">Versión</th>
                    <th scope="col" class="px-4 py-3">Fecha y Hora</th>
                    <th scope="col" class="px-4 py-3">Modificación</th>
                    <th scope="col" class="px-4 py-3">Hash (SHA-256)</th>
                    <th scope="col" class="px-4 py-3 text-right">Acción</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {versiones.map((v) => (
                    <tr class="hover:bg-surface-muted/50 transition-colors group">
                        <th scope="row" class="px-4 py-3 font-medium text-content">{v.version}</th>
                        <td class="px-4 py-3"><time datetime={v.fecha.toISOString()}>{v.fecha.toLocaleString('es-CO')}</time></td>
                        <td class="px-4 py-3">{v.modificacion}</td>
                        <td class="px-4 py-3"><code class="rounded bg-surface border border-border/50 px-1.5 py-0.5 font-mono text-xs" title="Código hash truncado para visualización">{v.hash.substring(0, 12)}...</code></td>
                        <td class="px-4 py-3 text-right">
                            <button
                                type="button"
                                class="verify-btn relative z-10 inline-flex items-center rounded border border-brand-600/40 bg-brand-600/10 px-3 py-1.5 text-xs font-semibold text-brand-700 transition-colors hover:bg-brand-600 hover:text-white disabled:opacity-50 disabled:cursor-not-allowed"
                                data-hash={v.hash}
                                data-version={v.version}
                                aria-label={'Verificar autenticidad de la ' + v.version}
                            >
                                <span class="btn-text">Verificar</span>
                            </button>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</section>

<script>
    function initVerifyButtons() {
        const announcer = document.getElementById('verify-announcer');

        document.querySelectorAll<HTMLButtonElement>('.verify-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const hash = btn.dataset.hash || '';
                const version = btn.dataset.version || '';
                const textSpan = btn.querySelector('.btn-text');
                
                if(!textSpan || !announcer) return;

                const orig = textSpan.textContent || 'Verificar';
                
                // Estado de carga
                textSpan.textContent = 'Verificando...';
                btn.setAttribute('aria-busy', 'true');
                btn.disabled = true;
                announcer.textContent = `Iniciando verificación criptográfica de la ${version}...`;
                
                // Simula latencia de consulta a la blockchain/servidor
                setTimeout(() => {
                    textSpan.textContent = '✓ Íntegro';
                    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
                    btn.classList.remove('bg-brand-600/10', 'text-brand-700');
                    btn.setAttribute('aria-busy', 'false');
                    
                    // Anuncio explícito para lectores de pantalla
                    announcer.textContent = `Éxito: La ${version} es íntegra y su hash coincide.`;
                    
                    // Restaura el botón después de unos segundos
                    setTimeout(() => { 
                        textSpan.textContent = orig; 
                        btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                        btn.classList.add('bg-brand-600/10', 'text-brand-700');
                        btn.disabled = false;
                        // No limpiamos el announcer inmediatamente para asegurar que se lea completo
                    }, 3500);
                }, 800);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVerifyButtons);
    } else {
        initVerifyButtons();
    }
</script>
