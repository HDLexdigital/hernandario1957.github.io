---
interface Version {
  id: string;
  version: string;
  fecha: Date;
  modificacion: string;
  hash: string;
}
interface Props {
  versiones: Version[];
}
const { versiones } = Astro.props;
---

<section class="rounded-lg border border-border bg-surface-card p-5 mt-8 shadow-sm transition-all" aria-labelledby="history-heading">
    <h2 id="history-heading" class="font-serif text-xl font-semibold text-content mb-4">Historial de Trazabilidad y Versiones</h2>

    <div class="w-full overflow-x-auto focus:outline-none focus:ring-2 focus:ring-brand-600 rounded" tabindex="0" aria-label="Tabla de historial de versiones desplazable">
        <table class="w-full text-left text-sm text-content-muted border-collapse min-w-[800px]">
            <caption class="sr-only">Registro de cambios y validación criptográfica del documento</caption>
            <thead class="bg-surface-muted text-content border-b border-border text-xs uppercase font-semibold">
                <tr>
                    <th scope="col" class="px-4 py-3">Versión</th>
                    <th scope="col" class="px-4 py-3">Fecha y Hora</th>
                    <th scope="col" class="px-4 py-3">Modificación</th>
                    <th scope="col" class="px-4 py-3">Hash (SHA-256)</th>
                    <th scope="col" class="px-4 py-3 text-right">Acción</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                {versiones.map((v) => (
                    <tr class="hover:bg-surface-muted/50 transition-colors group">
                        <th scope="row" class="px-4 py-3 font-medium text-content">{v.version}</th>
                        <td class="px-4 py-3"><time datetime={v.fecha.toISOString()}>{v.fecha.toLocaleString('es-CO')}</time></td>
                        <td class="px-4 py-3">{v.modificacion}</td>
                        <td class="px-4 py-3"><code class="rounded bg-surface px-1.5 py-0.5 font-mono text-xs">{v.hash.substring(0, 12)}...</code></td>
                        <td class="px-4 py-3 text-right">
                            <button
                                type="button"
                                class="verify-btn relative z-10 inline-flex items-center rounded border border-brand-600/40 bg-brand-600/10 px-3 py-1.5 text-xs font-semibold text-brand-700 transition-colors hover:bg-brand-600 hover:text-white"
                                data-hash={v.hash}
                                data-version={v.version}
                                aria-label={'Verificar certificado de la ' + v.version}
                            >
                                Verificar
                            </button>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</section>

<script>
    function initVerifyButtons() {
        document.querySelectorAll<HTMLButtonElement>('.verify-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const hash = btn.dataset.hash || '';
                const version = btn.dataset.version || '';
                
                console.log(`[Validación] Verificando ${version} con hash: ${hash}`);
                
                const orig = btn.textContent || '';
                btn.textContent = 'Verificando...';
                
                // Simula latencia de consulta a la blockchain/servidor
                setTimeout(() => {
                    btn.textContent = '✓ Íntegro';
                    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
                    btn.classList.remove('bg-brand-600/10', 'text-brand-700');
                    
                    // Restaura el botón
                    setTimeout(() => { 
                        btn.textContent = orig; 
                        btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                        btn.classList.add('bg-brand-600/10', 'text-brand-700');
                    }, 2500);
                }, 800);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initVerifyButtons);
    } else {
        initVerifyButtons();
    }
</script>
