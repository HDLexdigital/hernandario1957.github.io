---
interface Props {
  slug: string;
  title: string;
  tipo?: string;
  numero?: string;
  fecha?: Date;
  resumen?: string;
  materia?: string;
  vigente?: boolean;
}
const { slug, title, tipo, numero, fecha, resumen, materia, vigente = true } = Astro.props;

const tipoLabel: Record<string, string> = {
  ley: 'Ley', decreto: 'Decreto', resolucion: 'Resolución', ordenanza: 'Ordenanza'
};
const tipoColor: Record<string, string> = {
  ley: 'bg-brand-600/15 text-content/70 border-brand-600/30',
  decreto: 'bg-amber-600/15 text-content/70 border-amber-600/30',
  resolucion: 'bg-emerald-600/15 text-content/70 border-emerald-600/30',
  ordenanza: 'bg-purple-600/15 text-content/70 border-purple-600/30'
};
---

<article class="group rounded-lg border border-border bg-surface-muted p-5 transition-all hover:border-border-strong hover:shadow-md dark:hover:ring-2 dark:hover:ring-brand-500/40">
  <div class="flex items-center gap-2 flex-wrap mb-3">
    {tipo && (
      <span class:list={['inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium', tipoColor[tipo] || tipoColor.ley]}>
        {tipoLabel[tipo] || tipo}
      </span>
    )}
    {numero && <span class="font-mono text-xs text-content-muted">{numero}</span>}
    {!vigente && <span class="text-xs text-red-400 font-medium">Derogada</span>}
  </div>

  <h3 class="font-serif text-lg font-semibold text-content leading-snug">
    <a href={'/normativa/' + slug} class="hover:text-brand-400 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-600 rounded">
      {title}
    </a>
  </h3>

  {resumen && <p class="mt-2 text-sm text-content-muted line-clamp-3">{resumen}</p>}

  <div class="mt-4 flex items-center justify-between text-xs text-content-subtle">
    {fecha && <time datetime={fecha.toISOString()}>{fecha.toLocaleDateString('es-AR', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
    {materia && <span class="capitalize">{materia}</span>}
  </div>
</article>
