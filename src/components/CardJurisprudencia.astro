---
interface Props {
  slug: string;
  title: string;
  tribunal?: string;
  fecha?: Date;
  resumen?: string;
}

const { slug, title, tribunal = 'Corte Constitucional', fecha, resumen } = Astro.props;
---

<article class="relative group rounded-lg border border-border bg-surface-card p-5 transition-all hover:border-border-strong hover:shadow-md dark:hover:ring-2 dark:hover:ring-brand-500/40">
  <div class="flex items-center gap-2 flex-wrap mb-3">
    <span class="inline-flex items-center rounded-md border border-indigo-600/30 bg-indigo-600/15 px-2 py-0.5 text-xs font-medium text-content/70">
      Jurisprudencia
    </span>
    {tribunal && <span class="font-mono text-xs text-content-muted">{tribunal}</span>}
  </div>

  <h3 class="font-serif text-lg font-semibold text-content leading-snug">
    <a href={'/jurisprudencia/' + slug} class="after:absolute after:inset-0 hover:text-brand-400 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-600 rounded">
      {title}
    </a>
  </h3>

  {resumen && <p class="mt-2 text-sm text-content-muted line-clamp-3">{resumen}</p>}

  <div class="mt-4 flex items-center justify-between text-xs text-content-subtle border-t border-border pt-3">
    {fecha && <time datetime={fecha.toISOString()}>{fecha.toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
    <span class="text-brand-600 font-medium group-hover:underline relative z-10">Consultar &rarr;</span>
  </div>
</article>
