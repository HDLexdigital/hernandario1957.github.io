---
// src/components/Navbar.astro
const pathname = new URL(Astro.request.url).pathname;
---
<nav class="navbar" aria-label="Navegación principal">
  <div class="nav-container">
    <a href="/" class="nav-logo" aria-label="Mi Sitio - Ir al inicio">Mi Sitio</a>
    <ul class="nav-links" role="list">
      <li>
        <a 
          href="/" 
          class="nav-item" 
          aria-current={pathname === "/" ? "page" : undefined}
        >Inicio</a>
      </li>
      <li>
        <a 
          href="/proyectos" 
          class="nav-item" 
          aria-current={pathname.startsWith("/proyectos") ? "page" : undefined}
        >Proyectos</a>
      </li>
      <li>
        <a 
          href="/contacto" 
          class="nav-item" 
          aria-current={pathname.startsWith("/contacto") ? "page" : undefined}
        >Contacto</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .navbar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 1rem 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
  }
  .nav-container {
    max-width: 50rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-logo {
    font-weight: 700;
    color: #4f46e5;
    text-decoration: none;
    font-size: 1.25rem;
    font-family: system-ui, -apple-system, sans-serif;
    border-radius: 0.25rem;
  }
  .nav-logo:focus-visible {
    outline: 2px solid #4f46e5;
    outline-offset: 4px;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item {
    text-decoration: none;
    color: #4b5563;
    font-weight: 500;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    transition: color 0.2s;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }
  .nav-item:hover {
    color: #4f46e5;
  }
  /* Estilo clave para accesibilidad por teclado */
  .nav-item:focus-visible {
    outline: 2px solid #4f46e5;
    outline-offset: 2px;
    color: #4f46e5;
  }
  /* Estilo para la página activa indicada por aria-current */
  .nav-item[aria-current="page"] {
    color: #4f46e5;
    font-weight: 700;
  }
</style>
