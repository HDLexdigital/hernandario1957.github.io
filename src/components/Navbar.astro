---
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/', label: 'Inicio', match: pathname === '/' },
  { href: '/catalogo', label: 'Catálogo', match: pathname.startsWith('/catalogo') },
  { href: '/normativa', label: 'Normativa', match: pathname.startsWith('/normativa') },
  { href: '/jurisprudencia', label: 'Jurisprudencia', match: pathname.startsWith('/jurisprudencia') },
  { href: '/doctrina', label: 'Doctrina', match: pathname.startsWith('/doctrina') },
  { href: '/validacion', label: 'Validación', match: pathname.startsWith('/validacion') }
];
---

<header class="border-b border-border bg-surface/95 backdrop-blur sticky top-0 z-30">
  <div class="container">
    <div class="flex min-h-16 items-center justify-between gap-4">
      <a
        href="/"
        class="shrink-0 rounded-md font-serif text-lg font-semibold tracking-tight text-content transition-colors hover:text-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
        aria-label="LexDigitalHD — Ir al inicio"
      >
        LexDigitalHD
      </a>

      <nav
        class="hidden md:flex items-center gap-1"
        aria-label="Navegación principal"
      >
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              item.match
                ? 'bg-surface-muted text-brand-600'
                : 'text-content-muted hover:bg-surface-muted hover:text-content'
            ]}
            aria-current={item.match ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
