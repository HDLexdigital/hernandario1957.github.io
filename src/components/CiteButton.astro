---
interface Props {
  title: string;
  tipo?: string;
  numero?: string;
  fecha?: Date;
  slug: string;
}
const { title, tipo, numero, fecha, slug } = Astro.props;
const year = fecha ? fecha.getFullYear() : new Date().getFullYear();
const tipoCap = tipo ? tipo.charAt(0).toUpperCase() + tipo.slice(1) : 'Norma';
const cita = tipoCap + (numero ? ' ' + numero : '') + ', "' + title + '", ' + year + '. LexDigitalHD, https://lexdigitalhd.com/normativa/' + slug;
---

<button
  type="button"
  data-cite={cita}
  class="cite-btn inline-flex items-center gap-2 rounded-md border border-border bg-surface-muted px-3 py-2 text-xs font-medium text-content-muted hover:text-content hover:border-border-strong transition-colors"
  aria-label="Copiar cita bibliográfica"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
  </svg>
  <span>Copiar cita</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cite-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const cita = btn.dataset.cite || '';
      const label = btn.querySelector('span');
      try {
        await navigator.clipboard.writeText(cita);
        if (label) {
          const orig = label.textContent;
          label.textContent = '✓ Copiada';
          setTimeout(() => { label.textContent = orig; }, 1800);
        }
      } catch (e) { console.error(e); }
    });
  });
</script>
