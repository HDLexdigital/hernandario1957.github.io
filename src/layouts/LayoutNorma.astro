---
import LayoutBase from './LayoutBase.astro';

interface Props {
  titulo: string;
  descripcion: string;
  version?: string;
  estadoVigencia?: string;
}

const { titulo, descripcion, version, estadoVigencia } = Astro.props;

const badgeColor =
  estadoVigencia === 'Vigente'
    ? 'bg-emerald-600/10 text-emerald-500 border-emerald-600/20'
    : estadoVigencia === 'Modificado Parcialmente'
      ? 'bg-amber-500/10 text-amber-400 border-amber-500/20'
      : 'bg-surface-muted text-content-muted border-border';
---

<LayoutBase title={`${titulo} | LexDigitalHD`} description={descripcion}>
  <div class="border-b border-border bg-surface">
    <div class="container py-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-content-muted">
            Publicación jurídica
          </p>
          <h1 class="mt-1 font-serif text-2xl font-semibold text-content">
            {titulo}
          </h1>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {estadoVigencia && (
            <span class={`rounded-full border px-2.5 py-1 text-xs font-medium ${badgeColor}`}>
              {estadoVigencia}
            </span>
          )}

          {version && (
            <span class="rounded border border-border-strong bg-surface-muted px-2 py-1 text-xs font-mono text-content-muted">
              v{version}
            </span>
          )}
        </div>
      </div>

      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-content-muted">
        {descripcion}
      </p>
    </div>
  </div>

  <slot />
</LayoutBase>
