---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LexDigitalHD',
  description = 'Publicación y validación jurídica con trazabilidad digital.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" id="html-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="bg-surface text-content antialiased font-sans m-0 p-0">
    <Navbar />

    <main class="min-h-[75vh]">
      <slot />
    </main>

    <Footer />
  </body>
</html>
