---
import LayoutBase from '../../layouts/LayoutBase.astro';
import HistorialVersiones from '../../components/HistorialVersiones.astro';

// Datos de prueba
const historialPrueba = [
  { id: '1', version: 'v2.1', fecha: new Date("2026-03-15T14:32:00"), modificacion: 'Actualización de anexo técnico', hash: '8f4c9a2d3b1a8f4c9a2d3b1a' },
  { id: '2', version: 'v1.0', fecha: new Date("2025-11-05T16:00:00"), modificacion: 'Publicación original sellada', hash: '99x8y7z6w5v499x8y7z6w5v4' }
];
---

<LayoutBase title="Validación | LexDigitalHD">
  <section class="container py-12 md:py-16" aria-labelledby="page-title">
    <header class="mb-10">
      <h1 id="page-title" class="font-serif text-4xl font-semibold tracking-tight text-content">Validación Documental</h1>
      <p class="mt-3 max-w-2xl text-lg text-content-muted">
        Comprobá la autenticidad e integridad de los documentos mediante hash criptográfico y sello verificable.
      </p>
    </header>

    <!-- Módulo de Validación Interactivo -->
    <div class="mb-12 rounded-lg border border-border bg-surface p-6 shadow-sm">
      <h2 id="validation-heading" class="text-xl font-semibold text-content mb-4">Verificar nuevo documento</h2>
      
      <form id="validation-form" class="space-y-4" aria-labelledby="validation-heading">
        <div class="flex flex-col gap-1.5">
          <label for="hash-input" class="text-sm font-semibold text-content">Código Hash (SHA-256)</label>
          <div class="flex gap-2 flex-wrap sm:flex-nowrap">
            <input 
              type="text" 
              id="hash-input" 
              name="hash" 
              placeholder="Ej. 8f4c9a2d3b1a..." 
              required 
              aria-describedby="hash-hint"
              aria-invalid="false"
              class="flex-1 rounded-md border border-border bg-surface px-3 py-2 text-sm text-content transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/40 aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-red-500/40"
            />
            <button 
              type="submit" 
              class="inline-flex h-9 items-center justify-center rounded-md bg-brand-600 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-600 focus:ring-offset-2 disabled:opacity-50"
            >
              Validar Código
            </button>
          </div>
          <span id="hash-hint" class="text-xs text-content-muted">Ingrese la cadena alfanumérica del documento.</span>
        </div>
        
        <!-- Región oculta para anuncios del lector de pantalla -->
        <div id="form-announcer" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
        
        <!-- Alerta visual de resultado (role="alert") -->
        <div id="validation-result" class="hidden rounded-md p-4 mt-4" role="alert">
            <p id="result-message" class="text-sm font-medium"></p>
        </div>
      </form>
    </div>

    <!-- Historial de versiones previamente auditado -->
    <HistorialVersiones versiones={historialPrueba} />
  </section>
</LayoutBase>

<script>
  function initValidationForm() {
    const form = document.getElementById('validation-form');
    const input = document.getElementById('hash-input') as HTMLInputElement;
    const announcer = document.getElementById('form-announcer');
    const resultContainer = document.getElementById('validation-result');
    const resultMessage = document.getElementById('result-message');

    if (form && input && announcer && resultContainer && resultMessage) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = input.value.trim();
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

        // Simulamos una validación simple (ej. mínimo 10 caracteres)
        if (val.length < 10) { 
          input.setAttribute('aria-invalid', 'true');
          announcer.textContent = 'Error: El código hash ingresado no es válido.';
          resultContainer.className = 'rounded-md p-4 mt-4 bg-red-50 border border-red-200 text-red-800';
          resultMessage.textContent = '⚠ El código hash ingresado es demasiado corto o tiene un formato inválido.';
          resultContainer.classList.remove('hidden');
          input.focus();
        } else {
          input.setAttribute('aria-invalid', 'false');
          btn.disabled = true;
          btn.textContent = 'Validando...';
          announcer.textContent = 'Validando código criptográfico con la base de datos, por favor espere.';
          resultContainer.classList.add('hidden');

          // Simular latencia de validación con el servidor
          setTimeout(() => {
            btn.disabled = false;
            btn.textContent = 'Validar Código';
            
            // Resultado Exitoso
            resultContainer.className = 'rounded-md p-4 mt-4 bg-emerald-50 border border-emerald-200 text-emerald-800';
            resultMessage.textContent = '✓ Documento auténtico. El hash coincide con los registros oficiales.';
            resultContainer.classList.remove('hidden');
            announcer.textContent = 'Validación exitosa. Documento auténtico. El hash coincide con los registros oficiales.';
          }, 1500);
        }
      });
      
      // Limpiar errores si el usuario empieza a escribir de nuevo
      input.addEventListener('input', () => {
         if (input.getAttribute('aria-invalid') === 'true') {
             input.setAttribute('aria-invalid', 'false');
             resultContainer.classList.add('hidden');
         }
      });
    }
  }

  // Soporte para View Transitions de Astro
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initValidationForm);
  } else {
    initValidationForm();
  }
</script>
