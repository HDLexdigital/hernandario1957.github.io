---
import LayoutBase from '@layouts/LayoutBase.astro';
---

<LayoutBase title="Proyectos | Mi Sitio Astro">
  <main>
    <h1>Mis Proyectos</h1>
    <p>Aquí encontrarás una selección de los últimos desarrollos y trabajos en los que he estado colaborando.</p>
    <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <div style="padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; background: #f9fafb;">
        <h3 style="margin: 0 0 0.5rem 0; color: #4f46e5;">Proyecto Editorial</h3>
        <p style="margin: 0; font-size: 0.9rem; color: #4b5563;">Diagramación, maquetación y producción digital de textos estructurados.</p>
      </div>
      <div style="padding: 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; background: #f9fafb;">
        <h3 style="margin: 0 0 0.5rem 0; color: #4f46e5;">Desarrollo Web Moderno</h3>
        <p style="margin: 0; font-size: 0.9rem; color: #4b5563;">Sitios web estáticos y dinámicos ultrarrápidos construidos con Astro y Node.js v22.</p>
      </div>
    </div>
  </main>
</LayoutBase>
