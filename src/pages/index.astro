---
import LayoutBase from '../layouts/LayoutBase.astro';

const destacados = [
  {
    href: '/catalogo',
    titulo: 'Catálogo',
    descripcion: 'Publicaciones jurídicas en HTML, EPUB, PDF accesible, PDF fijo y PWA.',
    icono: '📖'
  },
  {
    href: '/normativa',
    titulo: 'Normativa',
    descripcion: 'Leyes, decretos y resoluciones con índice temático y búsqueda full-text.',
    icono: '⚖'
  },
  {
    href: '/jurisprudencia',
    titulo: 'Jurisprudencia',
    descripcion: 'Fallos clasificados por materia, tribunal y año, con sumarios editados.',
    icono: '📚'
  },
  {
    href: '/validacion',
    titulo: 'Validación',
    descripcion: 'Comprobá autenticidad e integridad de documentos mediante hash y sello.',
    icono: '🔒'
  }
];
---

<LayoutBase title="Inicio">
  <section class="container py-16 md:py-24 min-h-[80vh] flex flex-col justify-center">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-600">
      Plataforma jurídica
    </p>
    <h1 class="mt-3 font-serif text-4xl md:text-5xl font-semibold tracking-tight text-balance">
      Publicación y validación jurídica con trazabilidad digital
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-content-muted/80">
      Normativa, jurisprudencia y doctrina en un solo lugar, con sellado
      verificable y control de versiones.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/catalogo" class="btn-primary">Ver catálogo</a>
      <a href="/normativa" class="btn-ghost">Explorar normativa</a>
      <a href="/validacion" class="btn-ghost">Verificar documento</a>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {destacados.map((d) => (
        <a
          href={d.href}
          class="group card flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:border-brand-600/60 hover:shadow-lg dark:hover:ring-2 dark:hover:ring-brand-500/40 focus:outline-none focus:ring-2 focus:ring-brand-600 focus:ring-offset-2 focus:ring-offset-surface"
        >
          <span class="text-3xl" aria-hidden="true">{d.icono}</span>
          <h2 class="font-serif text-lg font-semibold text-content transition-colors group-hover:text-brand-400">
            {d.titulo}
          </h2>
          <p class="text-sm text-content-muted/80">
            {d.descripcion}
          </p>
          <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-brand-400 opacity-0 transition-opacity group-hover:opacity-100">
            Explorar
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</LayoutBase>
