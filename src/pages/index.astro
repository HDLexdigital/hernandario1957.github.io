---
import LayoutBase from '../layouts/LayoutBase.astro';

// Arreglo actualizado para incluir los pilares exactos de tu plataforma
const destacados = [
  {
    href: '/normativa',
    titulo: 'Normativa',
    descripcion: 'Leyes, decretos y resoluciones con índice temático y trazabilidad.',
    icono: '⚖️'
  },
  {
    href: '/jurisprudencia',
    titulo: 'Jurisprudencia',
    descripcion: 'Fallos clasificados por materia, tribunal y año, con sumarios editados.',
    icono: '📚'
  },
  {
    href: '/doctrina', // ¡Añadimos tu nueva sección!
    titulo: 'Doctrina',
    descripcion: 'Colección curada de ensayos y estudios jurídicos de alto nivel.',
    icono: '📖'
  },
  {
    href: '/validacion',
    titulo: 'Validación',
    descripcion: 'Comprueba la autenticidad e integridad de documentos mediante hash.',
    icono: '🔒'
  }
];
---

<LayoutBase title="Inicio | LexDigitalHD">
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 min-h-[80vh] flex flex-col justify-center">
    
    <!-- Encabezado Principal -->
    <p class="font-mono text-xs uppercase tracking-widest text-brand-400 font-semibold mb-3">
      LexDigitalHD 2.0
    </p>
    <h1 class="font-sans text-4xl md:text-5xl font-extrabold tracking-tight text-content text-balance leading-tight">
      Publicación y validación jurídica <br class="hidden md:block"/> con trazabilidad digital
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-content-muted leading-relaxed">
      Normativa, jurisprudencia y doctrina en un solo lugar, con sellado
      verificable y control de versiones garantizado.
    </p>

    <!-- Botones de Acción Rápida (Adaptados a tu paleta oscura) -->
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/normativa" class="px-6 py-3 bg-brand-500 hover:bg-brand-400 text-white text-sm font-bold rounded-lg transition-colors focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 focus:ring-offset-surface shadow-sm">
        Explorar Normativa
      </a>
      <a href="/doctrina" class="px-6 py-3 bg-surface-raised border border-border-strong text-content hover:text-brand-400 text-sm font-semibold rounded-lg transition-colors focus:ring-2 focus:ring-brand-500 shadow-sm">
        Leer Doctrina
      </a>
      <a href="/validacion" class="px-6 py-3 bg-surface-raised border border-border-strong text-content hover:text-brand-400 text-sm font-semibold rounded-lg transition-colors focus:ring-2 focus:ring-brand-500 shadow-sm">
        Verificar Documento
      </a>
    </div>

    <!-- Cuadrícula de Tarjetas -->
    <div class="mt-20 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {destacados.map((d) => (
        <a
          href={d.href}
          class="group bg-surface-raised border border-border-strong p-6 rounded-xl flex flex-col gap-4 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500/50 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <span class="text-3xl bg-surface p-3 rounded-lg w-fit border border-border" aria-hidden="true">{d.icono}</span>
          <h2 class="font-bold text-xl text-content transition-colors group-hover:text-brand-400">
            {d.titulo}
          </h2>
          <p class="text-sm text-content-muted leading-relaxed">
            {d.descripcion}
          </p>
          <span class="mt-auto pt-4 inline-flex items-center gap-1 text-xs font-bold text-brand-400 opacity-0 transition-opacity group-hover:opacity-100">
            Explorar sección
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>

  </section>
</LayoutBase>