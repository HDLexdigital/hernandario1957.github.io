---
import LayoutBase from '../../layouts/LayoutBase.astro';
---

<LayoutBase title="Dashboard de Compilación | LexDigitalHD">
  <main class="admin-container" role="main">
    <header class="admin-header">
      <h1>Panel de Control y Compilación Asíncrona</h1>
      <p class="doc-subtitle" role="doc-subtitle">Gestión de pipelines de publicación jurídica e integración IPC.</p>
    </header>

    <section class="control-panel" aria-label="Controles de ejecución">
      <div class="actions">
        <button id="btnIniciarBuild" class="btn-primary" type="button">Ejecutar Compilación (Watchdog)</button>
        <span id="buildStatus" class="status-indicator idle">Sistema en espera</span>
      </div>
    </section>

    <section class="terminal-section" aria-label="Consola de registro en vivo">
      <div class="terminal-header">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">watchdog@lexdigitalhd:~# tail -f /var/log/build-stream</span>
      </div>
      <div id="terminalConsole" class="terminal-body" role="log" aria-live="polite">
        <div class="log-line">[12:59:20] Sistema inicializado. Directorio IPC listo.</div>
      </div>
    </section>
  </main>
</LayoutBase>

<style>
  .admin-container {
    max-width: 900px;
    margin: 2.5rem auto;
    padding: 1rem;
  }
  .admin-header {
    margin-bottom: 1.5rem;
  }
  .admin-header h1 {
    font-size: 2rem;
    color: #111827;
    margin-bottom: 0.25rem;
  }
  .doc-subtitle {
    color: #4b5563;
    font-size: 1rem;
  }
  .control-panel {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .btn-primary {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    padding: 0.6rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .btn-primary:hover {
    background-color: #1d4ed8;
  }
  .status-indicator {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 0.25rem;
  }
  .status-indicator.idle {
    background-color: #f3f4f6;
    color: #374151;
  }
  .status-indicator.running {
    background-color: #fef3c7;
    color: #d97706;
  }
  .status-indicator.success {
    background-color: #d1fae5;
    color: #065f46;
  }
  .terminal-section {
    background: #0f172a;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  .terminal-header {
    background: #1e293b;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .terminal-dot.red { background-color: #ef4444; }
  .terminal-dot.yellow { background-color: #f59e0b; }
  .terminal-dot.green { background-color: #10b981; }
  .terminal-title {
    margin-left: 0.5rem;
    font-family: monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }
  .terminal-body {
    padding: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    color: #38bdf8;
    height: 350px;
    overflow-y: auto;
    line-height: 1.5;
  }
  .log-line {
    margin-bottom: 0.35rem;
  }
  .log-line.error { color: #f87171; }
  .log-line.success { color: #4ade80; }
  .log-line.warning { color: #facc15; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('btnIniciarBuild');
    var status = document.getElementById('buildStatus');
    var consoleDiv = document.getElementById('terminalConsole');

    if (!btn || !consoleDiv || !status) return;

    btn.addEventListener('click', function() {
      btn.setAttribute('disabled', 'true');
      status.textContent = 'Compilando...';
      status.className = 'status-indicator running';
      
      consoleDiv.innerHTML += '<div class="log-line">[INFO] Solicitando compilación mediante archivo IPC...</div>';

      setTimeout(() => {
        consoleDiv.innerHTML += '<div class="log-line success">[SUCCESS] Pipeline completado correctamente vía Watchdog.</div>';
        consoleDiv.scrollTop = consoleDiv.scrollHeight;
        btn.removeAttribute('disabled');
        status.textContent = 'Completado con éxito';
        status.className = 'status-indicator success';
      }, 1500);
    });
  });
</script>
