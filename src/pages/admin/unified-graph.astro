---
import fs from 'node:fs';
import path from 'node:path';

const publicDir = path.resolve(process.cwd(), 'public');
const centralityRaw = fs.readFileSync(path.join(publicDir, 'api/v1/metrics/centrality.json'), 'utf8');
const corporaRaw = fs.readFileSync(path.join(publicDir, 'api/v1/corpora.json'), 'utf8');
const art86ImpactRaw = fs.readFileSync(path.join(publicDir, 'api/v1/impact/co/constitucion/art/86.json'), 'utf8');

const centrality = JSON.parse(centralityRaw);
const corporaData = JSON.parse(corporaRaw);
const art86Impact = JSON.parse(art86ImpactRaw);
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin: Grafo Legal Unificado — LexDigitalHD</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; padding: 2rem; margin: 0; }
    .container { max-width: 1200px; margin: 0 auto; }
    .disclaimer { background: #451a03; border: 1px solid #b45309; color: #fde68a; padding: 1rem; border-radius: 8px; margin-bottom: 2rem; }
    .card { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { padding: 0.6rem 0.8rem; border-bottom: 1px solid #334155; text-align: left; }
    th { background: #0f172a; color: #94a3b8; }
    .badge { background: #0284c7; color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-family: monospace; }
    .code { font-family: monospace; color: #38bdf8; }
  </style>
</head>
<body>
  <div class="container">
    <header style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
      <h1>Grafo Legal Unificado (Admin)</h1>
      <span class="badge">API v{centrality.meta.apiVersion}</span>
    </header>

    <div class="disclaimer" role="note">
      <strong>⚠️ Descargo Computacional de Métricas de Red:</strong><br />
      {centrality.meta.computationalDisclaimer}
    </div>

    <div class="card">
      <h3>Trazabilidad Criptográfica</h3>
      <p>SHA-256 del Grafo Origen: <span class="code">{centrality.meta.sourceGraphSha256}</span></p>
      <p>Generado en: <span class="code">{centrality.meta.generatedAt}</span></p>
    </div>

    <div class="card">
      <h3>Centralidad Topológica Global (PageRank)</h3>
      <table>
        <thead>
          <tr>
            <th>Rank</th>
            <th>ID Global</th>
            <th>Denominación</th>
            <th>In-Degree</th>
            <th>Puntaje</th>
          </tr>
        </thead>
        <tbody>
          {centrality.topCentralNodes.map((n: any) => (
            <tr>
              <td><span class="badge">#{n.rank}</span></td>
              <td class="code">{n.globalId}</td>
              <td>{n.title}</td>
              <td>{n.inDegree}</td>
              <td>{(n.authorityScore * 100).toFixed(4)}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
