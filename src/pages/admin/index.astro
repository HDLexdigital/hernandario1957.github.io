---
import * as fs from 'fs/promises';
import * as path from 'path';
import { CorpusRegistryService } from '../../services/corpora/CorpusRegistryService';
import { CorporaPathResolver } from '../../services/corpora/CorporaPathResolver';

async function safeReadJson(absolutePath: string) {
  try {
    const raw = await fs.readFile(absolutePath, 'utf8');
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

// 1. Obtener catálogo maestro de corpora
const registryService = new CorpusRegistryService();
const registry = await registryService.getRegistry();
const corporaList = Object.values(registry.corpora);

// 2. Determinar corpus activo desde la URL (fallback al predeterminado)
const selectedSlug = Astro.url.searchParams.get('corpus') || 'constitucion';
const activeCorpus = corporaList.find(c => c.slug === selectedSlug) || corporaList[0];

// 3. Resolver rutas aisladas para el corpus seleccionado
const corpusBuildsDir = CorporaPathResolver.getBuildsDir(activeCorpus.slug);
const corpusReleasesDir = CorporaPathResolver.getReleasesDir(activeCorpus.slug);
const corpusIndexesDir = CorporaPathResolver.getIndexesDir(activeCorpus.slug);

const historyPath = CorporaPathResolver.getHistoryPath(activeCorpus.slug);
const currentReleasePath = path.resolve(corpusReleasesDir, 'current.json');
const previousReleasePath = path.resolve(corpusReleasesDir, 'previous.json');
const impactPath = path.resolve(corpusIndexesDir, 'impact-metrics.json');
const versionsPath = path.resolve(corpusIndexesDir, 'versions.json');
const remoteMirrorPath = path.resolve(process.cwd(), `dist/cloud-mirror/releases/${activeCorpus.slug}/current.json`);

// 4. Telemetría específica del corpus
const currentRelease = await safeReadJson(currentReleasePath);
const previousRelease = await safeReadJson(previousReleasePath);
const remotePointer = await safeReadJson(remoteMirrorPath);
const impactData = await safeReadJson(impactPath);
const historyData = await safeReadJson(historyPath);
const versionsData = await safeReadJson(versionsPath);

const transactions = Array.isArray(historyData) ? historyData : (historyData?.transactions || []);
const latestTxs = transactions.slice(-6).reverse();

const totalBuilds = transactions.length;
const failedBuilds = transactions.filter((tx: any) => tx.status === 'failed').length;
const successRate = totalBuilds === 0 ? 0 : Math.round(((totalBuilds - failedBuilds) / totalBuilds) * 100);

const mutatedArticles = impactData?.mostMutatedArticles?.slice(0, 5) || [];
const totalNodes = versionsData?.nodes?.length || 0;
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>LexDigitalHD - Control Plane Multi-Corpus</title>
  <style>
    :root { --bg: #f4f7f6; --sidebar: #1a252f; --panel: #ffffff; --text: #2c3e50; --accent: #3498db; --success: #2ecc71; --danger: #e74c3c; --warning: #f1c40f; }
    body { font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; display: flex; height: 100vh; background: var(--bg); color: var(--text); }
    
    aside { width: 270px; background: var(--sidebar); color: #ecf0f1; padding: 1.5rem; display: flex; flex-direction: column; }
    main { flex: 1; padding: 2rem; overflow-y: auto; display: flex; flex-direction: column; gap: 2rem; }
    
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    
    .card { background: var(--panel); padding: 1.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; }
    h2, h3 { margin-top: 0; color: var(--sidebar); }
    .metric-value { font-size: 2rem; font-weight: bold; margin: 0.5rem 0; color: var(--sidebar); }
    .metric-label { font-size: 0.85rem; color: #7f8c8d; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .badge { padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
    .badge.success { background: #d5f5e3; color: #1e8449; }
    .badge.failed { background: #fadbd8; color: #943126; }
    .badge.rolled-back { background: #fef9e7; color: #b7950b; }
    
    .corpus-selector-box { background: #2c3e50; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem; }
    .corpus-select { width: 100%; padding: 0.6rem; border-radius: 4px; border: 1px solid #4a6278; background: #34495e; color: #fff; font-size: 0.9rem; cursor: pointer; }
    
    .btn { padding: 0.6rem 1.2rem; border-radius: 4px; border: none; font-weight: 600; cursor: pointer; font-size: 0.85rem; transition: background 0.2s; }
    .btn-sync { background: var(--accent); color: white; }
    .btn-sync:hover { background: #2980b9; }
    .btn-rollback { background: var(--danger); color: white; margin-left: 0.5rem; }
    .btn-rollback:hover { background: #c0392b; }
    
    .bar-chart { margin-top: 1rem; }
    .bar-row { display: flex; align-items: center; margin-bottom: 0.8rem; }
    .bar-label { width: 100px; font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bar-track { flex: 1; height: 8px; background: #ecf0f1; border-radius: 4px; margin: 0 1rem; overflow: hidden; }
    .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; }
    .bar-value { width: 30px; font-size: 0.8rem; color: #7f8c8d; text-align: right; }
    
    .release-box { padding: 1rem; border-radius: 6px; border-left: 4px solid var(--accent); background: #f8fafc; margin-bottom: 1rem; }
    .release-box.previous { border-left-color: #bdc3c7; opacity: 0.85; }
  </style>
</head>
<body>

  <aside>
    <h2 style="border-bottom: 1px solid #2c3e50; padding-bottom: 0.8rem;">LexDigitalHD<br><span style="font-size: 0.8rem; font-weight: 400; color: #95a5a6;">Control Plane Multi-Tenant</span></h2>
    
    <!-- SELECTOR GLOBAL DE CORPUS -->
    <div class="corpus-selector-box">
      <label for="corpusDropdown" style="font-size: 0.75rem; text-transform: uppercase; color: #95a5a6; display: block; margin-bottom: 0.4rem; font-weight: 600;">Corpus Jurídico Activo</label>
      <select id="corpusDropdown" class="corpus-select" onchange="location.href='?corpus=' + this.value;">
        {corporaList.map((c) => (
          <option value={c.slug} selected={c.slug === activeCorpus.slug}>
            {c.shortTitle ? `[${c.shortTitle}] ` : ''}{c.title}
          </option>
        ))}
      </select>
    </div>

    <a href={`/admin?corpus=${activeCorpus.slug}`} style="color: #fff; text-decoration: none; padding: 0.8rem; background: #2c3e50; border-radius: 4px; margin-bottom: 0.5rem;">📊 Panel de Control</a>
    <a href={`/history?corpus=${activeCorpus.slug}`} style="color: #bdc3c7; text-decoration: none; padding: 0.8rem;">🏛️ Explorador Histórico</a>
    <a href={`/admin/diff?corpus=${activeCorpus.slug}`} style="color: #bdc3c7; text-decoration: none; padding: 0.8rem;">⚖️ Comparador Normativo</a>
    <a href="/" style="color: #bdc3c7; text-decoration: none; padding: 0.8rem; margin-top: auto;">← Volver al Portal</a>
  </aside>

  <main>
    <!-- CABECERA DEL CONTEXTO NORMATIVO -->
    <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #e2e8f0; padding-bottom: 1rem;">
      <div>
        <h1 style="margin: 0; font-size: 1.6rem; color: var(--sidebar);">{activeCorpus.title}</h1>
        <div style="font-size: 0.85rem; color: #7f8c8d; margin-top: 0.3rem;">
          ID Canónico: <code>{activeCorpus.corpusId}</code> | Jurisdicción: <strong>{activeCorpus.jurisdiction}</strong> | Promulgación: {activeCorpus.promulgationDate}
        </div>
      </div>
      <div>
        <span class="badge success" style="font-size: 0.85rem;">{activeCorpus.status}</span>
      </div>
    </div>

    <!-- 1. MÉTRICAS EJECUTIVAS DEL CORPUS -->
    <div class="grid-4">
      <div class="card" style="border-bottom: 4px solid var(--success);">
        <div class="metric-label">Pipeline Health</div>
        <div class="metric-value">{successRate}%</div>
        <div style="font-size: 0.8rem; color: #7f8c8d;">{totalBuilds} Builds en Ledger</div>
      </div>
      <div class="card" style="border-bottom: 4px solid var(--accent);">
        <div class="metric-label">Nodos Normativos</div>
        <div class="metric-value">{totalNodes}</div>
        <div style="font-size: 0.8rem; color: #7f8c8d;">Estructura versions.json</div>
      </div>
      <div class="card" style="border-bottom: 4px solid var(--warning);">
        <div class="metric-label">Mutaciones Registradas</div>
        <div class="metric-value">{impactData ? impactData.globalStabilityIndex : 0}</div>
        <div style="font-size: 0.8rem; color: #7f8c8d;">Reformas Históricas</div>
      </div>
      <div class="card" style="border-bottom: 4px solid var(--sidebar);">
        <div class="metric-label">Estado de Producción</div>
        <div class="metric-value" style="font-size: 1.1rem; margin-top: 0.8rem;">
          {currentRelease ? (
            <span class="badge success">PUBLICADO</span>
          ) : (
            <span class="badge failed">SIN DESPLIEGUE</span>
          )}
        </div>
      </div>
    </div>

    <!-- 2. GESTIÓN DE RELEASES AISLADAS -->
    <div class="grid-2">
      <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h3 style="margin: 0;">Releases & Despliegue</h3>
          <div>
            <button class="btn btn-sync" onclick={`triggerSync('${activeCorpus.slug}')`}>☁️ Replicar</button>
            {previousRelease && (
              <button class="btn btn-rollback" onclick={`triggerRollback('${activeCorpus.slug}')`}>🔄 Rollback</button>
            )}
          </div>
        </div>

        {currentRelease ? (
          <div class="release-box">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <strong>Release Activa</strong>
              <span class="badge success">Current</span>
            </div>
            <div style="font-size: 0.85rem; color: #555;">
              <div><strong>TX-ID:</strong> <code>{currentRelease.activeTxId}</code></div>
              <div><strong>Fecha:</strong> {new Date(currentRelease.publishedAt).toLocaleString()}</div>
            </div>
          </div>
        ) : (
          <p style="color: #7f8c8d; font-size: 0.9rem;">No hay release publicada para este corpus.</p>
        )}

        {previousRelease && (
          <div class="release-box previous">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <strong>Versión de Respaldo</strong>
              <span class="badge" style="background: #e2e8f0; color: #475569;">Rollback Target</span>
            </div>
            <div style="font-size: 0.85rem; color: #555;">
              <div><strong>TX-ID:</strong> <code>{previousRelease.activeTxId}</code></div>
            </div>
          </div>
        )}
      </div>

      <!-- 3. IMPACT ANALYZER ESPECÍFICO -->
      <div class="card">
        <h3>Analizador de Impacto ({activeCorpus.shortTitle || activeCorpus.slug})</h3>
        <p style="font-size: 0.85rem; color: #7f8c8d; margin-top: -0.5rem;">Artículos con mayor tasa de modificación.</p>
        
        {mutatedArticles.length > 0 ? (
          <div class="bar-chart">
            {mutatedArticles.map((art: any) => {
              const maxScore = mutatedArticles[0].mutationIndexScore || 1;
              const width = Math.max(5, (art.mutationIndexScore / maxScore) * 100);
              
              return (
                <div class="bar-row">
                  <div class="bar-label" title={art.title}>{art.nodeId}</div>
                  <div class="bar-track">
                    <div class="bar-fill" style={`width: ${width}%;`}></div>
                  </div>
                  <div class="bar-value">{art.totalReforms} ref.</div>
                </div>
              );
            })}
          </div>
        ) : (
          <p style="color: #7f8c8d; font-size: 0.9rem;">Sin datos de impacto generados para este corpus.</p>
        )}
      </div>
    </div>

    <!-- 4. LEDGER AISLADO -->
    <div class="card">
      <h3>Ledger de Transacciones: <code>{activeCorpus.slug}/builds/history.json</code></h3>
      <table style="width: 100%; text-align: left; border-collapse: collapse; margin-top: 1rem;">
        <thead>
          <tr style="border-bottom: 2px solid #ecf0f1; color: #7f8c8d; font-size: 0.85rem;">
            <th style="padding: 0.5rem;">TX-ID</th>
            <th style="padding: 0.5rem;">Fecha</th>
            <th style="padding: 0.5rem;">Estado</th>
            <th style="padding: 0.5rem;">Detalles / Logs</th>
          </tr>
        </thead>
        <tbody>
          {latestTxs.length > 0 ? (
            latestTxs.map((tx: any) => {
              let badgeClass = 'failed';
              if (tx.status === 'success') badgeClass = 'success';
              if (tx.status === 'published' || tx.status === 'published-remote') badgeClass = 'success';
              if (tx.status === 'rolled-back') badgeClass = 'rolled-back';

              return (
                <tr style="border-bottom: 1px solid #ecf0f1; font-size: 0.85rem;">
                  <td style="padding: 0.8rem; font-family: monospace;">{tx.txId}</td>
                  <td style="padding: 0.8rem;">{new Date(tx.timestamp).toLocaleString()}</td>
                  <td style="padding: 0.8rem;">
                    <span class={`badge ${badgeClass}`}>{tx.status}</span>
                  </td>
                  <td style="padding: 0.8rem; color: #555;">
                    {tx.logs && tx.logs.length > 0 ? tx.logs[tx.logs.length - 1] : 'Sin logs'}
                  </td>
                </tr>
              );
            })
          ) : (
            <tr>
              <td colspan="4" style="padding: 1rem; text-align: center; color: #7f8c8d;">
                No hay transacciones registradas para este corpus aún.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </main>

  <script>
    async function triggerSync(corpusSlug: string) {
      if (!confirm(`¿Replicar a la nube la versión activa de [${corpusSlug}]?`)) return;
      alert(`Sincronización remota para ${corpusSlug} activada.`);
    }

    async function triggerRollback(corpusSlug: string) {
      if (!confirm(`⚠️ ATENCIÓN: Se revertirá el release de [${corpusSlug}] a la versión anterior.\n\n¿Continuar?`)) return;
      alert(`Rollback para ${corpusSlug} ejecutado.`);
    }

    (window as any).triggerSync = triggerSync;
    (window as any).triggerRollback = triggerRollback;
  </script>
</body>
</html>
