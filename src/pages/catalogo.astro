---
import { getCollection } from 'astro:content';
import LayoutBase from '../layouts/LayoutBase.astro';
import CardPublicacion from '../components/CardPublicacion.astro';

const publicaciones = await getCollection('publicaciones');
const sorted = publicaciones.sort((a, b) => {
  if (a.data.destacado && !b.data.destacado) return -1;
  if (!a.data.destacado && b.data.destacado) return 1;
  return +b.data.fechaPublicacion - +a.data.fechaPublicacion;
});

const materias = [...new Set(sorted.flatMap((p) => p.data.materia))].sort();
---

<LayoutBase
  title="Catálogo"
  description="Publicaciones jurídicas en múltiples formatos. Normativa, doctrina y jurisprudencia."
>
  <section class="container py-12" aria-labelledby="titulo-catalogo">
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-widest text-brand-600 mb-2">
        Publicaciones
      </p>
      <h1 id="titulo-catalogo" class="font-serif text-4xl font-semibold tracking-tight text-content mb-3">
        Catálogo
      </h1>
      <p class="text-content-muted max-w-2xl">
        Obras jurídicas en HTML, EPUB, PDF accesible, PDF fijo y PWA.
      </p>
    </header>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center">
      <label for="search-publicaciones" class="sr-only">Buscar publicaciones</label>
      <input
        id="search-publicaciones"
        type="search"
        placeholder="Buscar por título, autor o materia..."
        class="flex-1 rounded-md border border-border bg-surface-muted px-4 py-2.5 text-sm text-content placeholder-content-placeholder focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-600/40"
      />
      <label for="filter-materia" class="sr-only">Filtrar por materia</label>
      <select
        id="filter-materia"
        class="rounded-md border border-border bg-surface-muted px-3 py-2.5 text-sm text-content"
      >
        <option value="">Todas las materias</option>
        {materias.map((m) => <option value={m}>{m}</option>)}
      </select>
    </div>

    <h2 id="titulo-publicaciones" class="sr-only">Publicaciones disponibles</h2>

    <div
      id="publicaciones-grid"
      class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      aria-labelledby="titulo-publicaciones"
    >
      {sorted.map((p) => (
        <CardPublicacion
          slug={p.slug}
          titulo={p.data.titulo}
          autores={p.data.autores}
          resumenCorto={p.data.resumenCorto}
          portada={p.data.portada}
          portadaAlt={p.data.portadaAlt}
          tipoAcceso={p.data.tipoAcceso}
          precioCOP={p.data.precioCOP}
          precioUSD={p.data.precioUSD}
          descuentoPorcentaje={p.data.descuentoPorcentaje}
          formatos={p.data.formatos}
          destacado={p.data.destacado}
          novedad={p.data.novedad}
        />
      ))}
    </div>

    <p id="empty-msg" class="hidden text-center py-12 text-content-muted">
      No se encontraron publicaciones.
    </p>
  </section>

  <script>
    const input = document.getElementById('search-publicaciones') as HTMLInputElement | null;
    const select = document.getElementById('filter-materia') as HTMLSelectElement | null;
    const grid = document.getElementById('publicaciones-grid');
    const empty = document.getElementById('empty-msg');
    if (input && grid && empty) {
      const filter = () => {
        const q = (input.value || '').toLowerCase().trim();
        const m = select?.value || '';
        let visible = 0;
        grid.querySelectorAll('article').forEach((el) => {
          const text = (el.textContent || '').toLowerCase();
          const matchQ = !q || text.includes(q);
          const matchM = !m || text.includes(m.toLowerCase());
          const show = matchQ && matchM;
          (el as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible++;
        });
        empty.classList.toggle('hidden', visible > 0);
      };
      input.addEventListener('input', filter);
      select?.addEventListener('change', filter);
    }
  </script>
